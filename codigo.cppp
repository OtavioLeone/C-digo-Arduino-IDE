// Definição dos pinos de hardware
const int RELAY_PIN = 0; // Pino de controle do relé da bomba
const int SWITCH_PIN = 4; // Pino da chave seletora de modo (Chuva/Seca)

// Definição dos tempos de ciclo em milissegundos para os testes
const unsigned long CHUVA_OFF = 25000; // Tempo com a bomba desligada no modo chuva const 
const unsigned long CHUVA_ON  = 10000; // Tempo com a bomba ligada no modo chuva 
const unsigned long SECA_OFF  = 5000; // Tempo com a bomba desligada no modo seca 
const unsigned long SECA_ON   = 20000; // Tempo com a bomba ligada no modo seca 

void setup() {
    pinMode(RELAY_PIN, OUTPUT); // Configura o pino do relé como saída  pinMode
    pinMode(SWITCH_PIN, INPUT_PULLUP); // Configura o pino da chave com resistor de pull-up interno  
    digitalWrite(RELAY_PIN, LOW); // Garante que a bomba inicia desligada
}

void loop() {
    // Lê o estado da chave seletora para definir o regime sazonal  
    bool modoChuva = (digitalRead(SWITCH_PIN) == HIGH);
    
    // Atribui os tempos correspondentes com base no modo selecionado (Chuva vs. Seca)  
    unsigned long tempoDesligado = modoChuva ? CHUVA_OFF : SECA_OFF;
    unsigned long tempoLigado    = modoChuva ? CHUVA_ON : SECA_ON;

    // Executa o estágio de repouso (bomba desligada)  
    digitalWrite(RELAY_PIN, LOW);
    delay(tempoDesligado);

  // Executa o estágio de aspersão/limpeza (bomba ligada)  
    digitalWrite(RELAY_PIN, HIGH);
    delay(tempoLigado);
}
